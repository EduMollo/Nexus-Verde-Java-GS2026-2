      "name": "Validar fontes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "jsCode": "const passos = $input.first().json;\nconst chamadas = new Set((passos.intermediateSteps || []).map(p => p.action?.tool));\nif (!chamadas.has('Consultar_ponto') || !chamadas.has('Consultar_procedimentos')) throw new Error('Consultas obrigatórias ausentes');\nconst raw = String(passos.output).trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'');\nconst resultado = JSON.parse(raw);\nconst fontes = $('Leitura do painel').first().json.body.fontes;\nif (!fontes.some(f => f.codigo === resultado.fonte) || typeof resultado.texto !== 'string' || !resultado.texto.trim() || resultado.texto.length > 900) throw new Error('Fonte ou orientação inválida');\nreturn [{json:{texto:resultado.texto.trim(),fonte:resultado.fonte}}];"
      }
    }
